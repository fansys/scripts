# 来源：https://github.com/qiangxinglin/Emby

[Script]
request if ${url} ~= /^https:\/\/mb3admin\.com\/admin\/service\/(registration\/(validateDevice|validate|getStatus)|appstore\/register|supporter\/retrievekey)\/?(\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/emby/emby.js") with tag="Emby", timeout=10

[Mitm]
hostname = mb3admin.com

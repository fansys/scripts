#!icon=https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/emby/icon.png
#!desc=Emby 五个注册相关接口的本地响应
#!author=qiangxinglin
#!homepage=https://github.com/fansys/scripts/tree/main/Scripts/emby
#!loon_version=3.5.1(983)

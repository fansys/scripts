#!name=G1 ACQ
#!icon=https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/icon.png
#!desc=G1 ACQ：Google One 原始 SKU 采集、三档商品编号改写、本机报告与 JSON 导出
#!author=crhywun
#!homepage=https://github.com/fansys/scripts
#!loon_version=3.5.1(983)
# 来源：https://github.com/crhywun/g1-acq/tree/v7.5.0

[Script]
request if ${url} ~= /^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$/ then script("https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/g1-sku-report.js") with tag="G1 SKU Report", timeout=20
response if ${url} ~= /^https:\/\/one\.google\.com\/(?!g1-sku-report\/?(?:\?|$))/ then script("https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/g1-acq.js") with requires_body=true, tag="G1 ACQ", timeout=20

[Mitm]
hostname = one.google.com

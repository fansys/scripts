#!name=G1 ACQ
#!icon=https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/icon.png
#!desc=G1 ACQ：Google One 原始 SKU 采集、本机 SKU 映射管理、预制模板与 JSON 导出
#!system=ios
# 来源：https://github.com/crhywun/g1-acq/tree/v7.12.0

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/fansys/scripts@main/Scripts/g1-acq/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
